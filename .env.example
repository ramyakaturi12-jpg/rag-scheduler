# Copy this file to .env and fill in your values
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the default model (gpt-4o-mini is cost-effective)
OPENAI_MODEL=gpt-4o-mini

# ChromaDB persistent storage path (relative to project root)
CHROMA_PERSIST_DIR=./chroma_db

# Schedule start date override (ISO format). Defaults to today.
# SCHEDULE_START_DATE=2026-08-16
